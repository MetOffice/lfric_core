module transpose_matrix_vector_mod_test

  use constants_mod, only : i_def
  use, intrinsic :: iso_fortran_env, only: real32, real64
  use funit

  implicit none

  private
  public :: test_real64, test_real32

  @TestCase
  type, extends(TestCase), public :: transpose_matrix_vector_mod_test_type
    private
  contains
    procedure test_real64
    procedure test_real32
  end type transpose_matrix_vector_mod_test_type

contains

  @test
  subroutine test_real64(this)

    use transpose_matrix_vector_kernel_mod, only : transpose_matrix_vector_code

    implicit none

    class(transpose_matrix_vector_mod_test_type), intent(inout) :: this

    real(kind=real64) :: d(1,4,2), x(4), y(2), answer(2)
    real(kind=real64) :: tol
    integer(kind=i_def) :: i

    ! Explicit temporary arrays to prevent run-time warnings
    integer(i_def) :: ninth(2)
    integer(i_def) :: twelth(4)

    ! Make up a matrix
    d(1,1,:) = (/ 2.0_real64, -2.0_real64 /)
    d(1,2,:) = (/ 3.0_real64, -1.0_real64 /)
    d(1,3,:) = (/ 0.4_real64,  1.3_real64 /)
    d(1,4,:) = (/ -4.5_real64, 7.9_real64 /)
    ! rhs vector
    x(:) = (/ 0.25_real64, 1.5_real64, -0.35_real64, 5.0_real64 /)
    ! lhs vector
    y(:) = 0.0_real64
    answer = matmul(transpose(d(1,:,:)),x)

    ninth = (/1_i_def, 2_i_def/)
    twelth = (/1_i_def, 2_i_def, 3_i_def, 4_i_def/)
    call transpose_matrix_vector_code(1_i_def, &
                                      1_i_def, &
                                      y,       &
                                      x,       &
                                      1_i_def, &
                                      d,       &
                                      2_i_def, &
                                      2_i_def, &
                                      ninth,   &
                                      4_i_def, &
                                      4_i_def, &
                                      twelth )

    tol = 1.0e-14_real64

    do i = 1,2
      @assertEqual( y(i), answer(i), tol )
    end do

  end subroutine test_real64

  @test
  subroutine test_real32(this)

    use transpose_matrix_vector_kernel_mod, only : transpose_matrix_vector_code

    implicit none

    class(transpose_matrix_vector_mod_test_type), intent(inout) :: this

    real(kind=real32) :: d(1,4,2), x(4), y(2), answer(2)
    real(kind=real32) :: tol
    integer(kind=i_def) :: i

    ! Explicit temporary arrays to prevent run-time warnings
    integer(i_def) :: ninth(2)
    integer(i_def) :: twelth(4)

    ! Make up a matrix
    d(1,1,:) = (/ 2.0_real32, -2.0_real32 /)
    d(1,2,:) = (/ 3.0_real32, -1.0_real32 /)
    d(1,3,:) = (/ 0.4_real32,  1.3_real32 /)
    d(1,4,:) = (/ -4.5_real32, 7.9_real32 /)
    ! rhs vector
    x(:) = (/ 0.25_real32, 1.5_real32, -0.35_real32, 5.0_real32 /)
    ! lhs vector
    y(:) = 0.0_real32
    answer = matmul(transpose(d(1,:,:)),x)

    ninth = (/1_i_def, 2_i_def/)
    twelth = (/1_i_def, 2_i_def, 3_i_def, 4_i_def/)
    call transpose_matrix_vector_code(1_i_def, &
                                      1_i_def, &
                                      y,       &
                                      x,       &
                                      1_i_def, &
                                      d,       &
                                      2_i_def, &
                                      2_i_def, &
                                      ninth,   &
                                      4_i_def, &
                                      4_i_def, &
                                      twelth )

    tol = 1.0e-6_real32

    do i = 1,2
      @assertEqual( y(i), answer(i), tol )
    end do

  end subroutine test_real32

end module transpose_matrix_vector_mod_test
